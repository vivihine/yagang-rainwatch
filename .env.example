# 本地调试用：复制此文件为 .env.local 并填写（.env.local 已被 .gitignore 忽略，不会提交）
# 本地运行 .\run.ps1 会自动加载 .env.local
#
# 推送通道（推荐 WxPusher，永久免费，微信接收）：
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
# 多人订阅：创建 WxPusher 主题后把主题ID填这里（逗号分隔）
WXPUSHER_TOPIC_IDS=
# 或者用极简推送 SPT（微信扫码即得，二选一）：
WXPUSHER_SPT=
#
# 和风天气（可选）
QWEATHER_HOST=
QWEATHER_KEY=
#
# GitHub API 部署（仅部署时需要）
GITHUB_TOKEN=
#
# 备选通道（可选）
PUSHPLUS_TOKEN=
BARK_KEY=
